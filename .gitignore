# Data trees: preserve directory layout via .gitkeep, ignore data payloads
raw_data/*
!raw_data/.gitkeep
processed_data/*
!processed_data/.gitkeep
derived_data/*
!derived_data/.gitkeep
# ...except committed model-run predictions (expensive GPU output, not regenerable
# without a GPU). Kept under version control per docs/pathb_runbook.md.
!derived_data/predictions/
!derived_data/predictions/**

# Generated outputs & logs: preserve directory layout via .gitkeep, ignore contents.
# The Path B run-of-record artifacts under these dirs are already tracked and stay
# tracked (gitignore does not untrack); new generated files remain ignored. To add
# a new run's outputs, `git add -f` the specific files.
results/*
!results/.gitkeep
figures/*
!figures/.gitkeep
tables/*
!tables/.gitkeep
logs/*
!logs/.gitkeep

# Quarantined premature Path-B work (see attic/README.md) -- not part of the repo
attic/
