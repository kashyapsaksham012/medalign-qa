# `provider: openai_compat` config (e.g. a Gemini / OpenRouter fallback).
# MEDALIGN_API_BASE=https://openrouter.ai/api/v1
# MEDALIGN_API_KEY=
# MEDALIGN_MODEL_PRIMARY=
