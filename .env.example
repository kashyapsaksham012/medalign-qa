# Copy to .env (gitignored) and fill in. Loaded by src/medalign_qa/models/env.py.
#
# Path B runs the substitute model LOCALLY via vLLM (configs/model/qwen25-7b-local.yaml)
# -- no API key or base URL is needed. Qwen2.5-7B-Instruct is an ungated model.
#
# Only set HF_TOKEN if you switch configs/model/*.yaml to a GATED Hugging Face model.
# HF_TOKEN=hf_...

# --- Legacy hosted OpenAI-compatible backend (models/openai_compat.py) ----------
